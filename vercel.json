{
  "buildCommand": null,
  "installCommand": null,
  "name": "content-freshness-dashboard",
  "public": true,
  "regions": ["iad1"],
  "env": [],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
